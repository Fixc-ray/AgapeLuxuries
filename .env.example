# Client (copy relevant values to client/.env; the publishable key is safe for browser use)
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://ddeivbfpagbaaioxikuy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server (copy relevant values to server/.env)
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
SUPABASE_URL=https://ddeivbfpagbaaioxikuy.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Obtain the server-only secret key from Supabase API Keys. Never expose it as VITE_*.
SUPABASE_SECRET_KEY=
# Random server-only value used to hash visitor and session identifiers.
ANALYTICS_SALT=
ADMIN_EMAIL=
MPESA_MODE=disabled
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=
STRIPE_SECRET_KEY=
EMAIL_PROVIDER=disabled
EMAIL_FROM=hello@agapeluxuries.co.ke
