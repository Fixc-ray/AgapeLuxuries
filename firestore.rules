rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /products/{id} {
      allow read: if resource.data.isPublished == true || admin();
      allow write: if admin();
    }
    match /categories/{id} { allow read: if true; allow write: if admin(); }
    match /brands/{id} { allow read: if true; allow write: if admin(); }
    match /banners/{id} { allow read: if resource.data.isPublished == true || admin(); allow write: if admin(); }
    match /storeSettings/{id} { allow read: if true; allow write: if admin(); }

    match /users/{uid} {
      allow read: if owns(uid) || admin();
      allow create: if owns(uid) && request.resource.data.role == 'customer';
      allow update: if owns(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','phone','photoURL','updatedAt']);
      allow delete: if false;
    }
    match /users/{uid}/addresses/{id} { allow read, write: if owns(uid); }
    match /carts/{uid} { allow read, write: if owns(uid); }
    match /wishlists/{uid} { allow read, write: if owns(uid); }

    match /orders/{id} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /payments/{id} { allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid); allow write: if false; }
    match /coupons/{id} { allow read, write: if admin(); }
    match /inventoryLogs/{id} { allow read, write: if admin(); }
    match /notifications/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.verifiedPurchase == true;
      allow update, delete: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
    }
    match /newsletterSubscribers/{id} { allow read: if admin(); allow write: if false; }
  }
}
